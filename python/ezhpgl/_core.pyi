from collections.abc import Iterator
from os import PathLike

class SourceSpan:
    @property
    def start(self) -> int: ...
    @property
    def end(self) -> int: ...

class Diagnostic:
    @property
    def code(self) -> str: ...
    @property
    def message(self) -> str: ...
    @property
    def span(self) -> SourceSpan: ...
    @property
    def command(self) -> str | None: ...
    @property
    def action(self) -> str: ...

class ParseError(ValueError):
    diagnostic: Diagnostic

class Limits:
    def __init__(self, *, max_input_bytes: int = 67108864,
                 max_command_bytes: int = 4194304, max_commands: int = 1000000,
                 max_arguments_per_command: int = 262144, max_diagnostics: int = 1024) -> None: ...
    @property
    def max_input_bytes(self) -> int: ...
    @property
    def max_command_bytes(self) -> int: ...
    @property
    def max_commands(self) -> int: ...
    @property
    def max_arguments_per_command(self) -> int: ...
    @property
    def max_diagnostics(self) -> int: ...

class DetectionResult:
    @property
    def container(self) -> str: ...
    @property
    def language(self) -> str: ...
    @property
    def reasons(self) -> list[str]: ...

class Command:
    @property
    def name(self) -> str: ...
    @property
    def kind(self) -> str: ...
    @property
    def span(self) -> SourceSpan: ...
    @property
    def payload_span(self) -> SourceSpan: ...
    @property
    def args(self) -> list[float]: ...
    @property
    def argument_spans(self) -> list[SourceSpan]: ...
    @property
    def raw(self) -> bytes: ...
    @property
    def data(self) -> bytes: ...
    @property
    def terminator(self) -> int | None: ...
    @property
    def print_terminator(self) -> bool | None: ...

class CommandIterator(Iterator[Command]):
    def __iter__(self) -> CommandIterator: ...
    def __next__(self) -> Command: ...

class RawDocument:
    @property
    def completeness(self) -> str: ...
    @property
    def diagnostics(self) -> list[Diagnostic]: ...
    @property
    def commands(self) -> list[Command]: ...
    @property
    def source_size(self) -> int: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> CommandIterator: ...

def detect_format(data: bytes) -> DetectionResult: ...
def parse_commands(data: bytes, *, strict: bool = True, limits: Limits | None = None) -> RawDocument: ...

class Point:
    @property
    def x(self) -> float: ...
    @property
    def y(self) -> float: ...

class Bounds:
    @property
    def min(self) -> Point: ...
    @property
    def max(self) -> Point: ...

class GeometryLimits:
    def __init__(self, *, max_pages: int = 10000, max_operations: int = 1000000,
                 max_vertices: int = 2000000, max_curve_segments: int = 65536,
                 max_polygon_vertices: int = 1000000, max_polygon_contours: int = 10000,
                 max_hatch_lines: int = 100000, max_label_bytes: int = 65536,
                 max_glyphs: int = 200000) -> None: ...
    @property
    def max_pages(self) -> int: ...
    @property
    def max_operations(self) -> int: ...
    @property
    def max_vertices(self) -> int: ...
    @property
    def max_curve_segments(self) -> int: ...
    @property
    def max_polygon_vertices(self) -> int: ...
    @property
    def max_polygon_contours(self) -> int: ...
    @property
    def max_hatch_lines(self) -> int: ...
    @property
    def max_label_bytes(self) -> int: ...
    @property
    def max_glyphs(self) -> int: ...

class DeviceProfile:
    def __init__(self, *, plot_size_mm: tuple[float, float] | None = None,
                 paper_size_mm: tuple[float, float] | None = None) -> None: ...
    @property
    def plot_size_mm(self) -> tuple[float, float] | None: ...
    @property
    def paper_size_mm(self) -> tuple[float, float] | None: ...

class ClipRegion:
    @property
    def kind(self) -> str: ...
    @property
    def bounds(self) -> Bounds | None: ...

class TransformState:
    @property
    def p1_plotter_units(self) -> Point: ...
    @property
    def p2_plotter_units(self) -> Point | None: ...
    @property
    def rotation(self) -> int: ...
    @property
    def scaling(self) -> str: ...
    @property
    def matrix(self) -> list[float]: ...
    @property
    def clip(self) -> ClipRegion | None: ...

class Style:
    @property
    def line(self) -> LineStyle | None: ...
    @property
    def pen(self) -> int: ...
    @property
    def color(self) -> str: ...
    @property
    def width_mm(self) -> float: ...

class LineStyle:
    @property
    def line_type(self) -> int | None: ...
    @property
    def pattern_length_mm(self) -> float | None: ...
    @property
    def phase_mm(self) -> float: ...
    @property
    def cap(self) -> int: ...
    @property
    def join(self) -> int: ...
    @property
    def miter_limit(self) -> float: ...

class Curve:
    @property
    def kind(self) -> str: ...
    @property
    def center(self) -> Point | None: ...
    @property
    def axis_u(self) -> Point | None: ...
    @property
    def axis_v(self) -> Point | None: ...
    @property
    def start_angle_deg(self) -> float | None: ...
    @property
    def sweep_angle_deg(self) -> float | None: ...
    @property
    def chord_mode(self) -> int | None: ...
    @property
    def chord_value(self) -> float | None: ...
    @property
    def control_points(self) -> list[Point]: ...
    @property
    def tolerance_mm(self) -> float | None: ...

class Contour:
    @property
    def points(self) -> list[Point]: ...
    @property
    def edges(self) -> list[ContourEdge]: ...

class ContourEdge:
    @property
    def start(self) -> int: ...
    @property
    def end(self) -> int: ...
    @property
    def pen_down(self) -> bool: ...
    @property
    def source(self) -> Provenance: ...
    @property
    def curve(self) -> Curve | None: ...

class FillStyle:
    @property
    def fill_type(self) -> int: ...
    @property
    def rule(self) -> str: ...
    @property
    def spacing_mm(self) -> float | None: ...
    @property
    def angle_deg(self) -> float: ...
    @property
    def hatch_lines(self) -> list[tuple[Point, Point]]: ...
    @property
    def hatch_phases_mm(self) -> list[float]: ...

class Provenance:
    @property
    def command_index(self) -> int: ...
    @property
    def command(self) -> str: ...
    @property
    def span(self) -> SourceSpan: ...

class PlotState:
    @property
    def text(self) -> TextState | None: ...
    @property
    def position_approximate(self) -> bool: ...
    @property
    def polygon_mode(self) -> bool: ...
    @property
    def transform(self) -> TransformState | None: ...
    @property
    def position(self) -> Point: ...
    @property
    def coordinate_mode(self) -> str: ...
    @property
    def pen(self) -> int: ...
    @property
    def pen_down(self) -> bool: ...

class Geometry:
    @property
    def label(self) -> Label | None: ...
    @property
    def curve(self) -> Curve | None: ...
    @property
    def contours(self) -> list[Contour]: ...
    @property
    def fill(self) -> FillStyle | None: ...
    @property
    def kind(self) -> str: ...
    @property
    def points(self) -> list[Point]: ...
    @property
    def start_dot(self) -> bool: ...

class PlotOperation:
    @property
    def approximate(self) -> bool: ...
    @property
    def clip(self) -> ClipRegion | None: ...
    @property
    def visible_bounds(self) -> Bounds | None: ...
    @property
    def geometry(self) -> Geometry: ...
    @property
    def style(self) -> Style: ...
    @property
    def source(self) -> Provenance: ...
    @property
    def path_id(self) -> int: ...

class PlotPage:
    @property
    def omitted_content(self) -> bool: ...
    @property
    def plot_size_mm(self) -> tuple[float, float] | None: ...
    @property
    def index(self) -> int: ...
    @property
    def paper_size_mm(self) -> tuple[float, float] | None: ...
    @property
    def bounds(self) -> Bounds | None: ...
    @property
    def operations(self) -> list[PlotOperation]: ...

class PlotDocument:
    @property
    def input_events(self) -> list[InputEvent]: ...
    @property
    def device_profile(self) -> DeviceProfile: ...
    @property
    def schema_version(self) -> int: ...
    @property
    def profile(self) -> str: ...
    @property
    def units(self) -> str: ...
    @property
    def completeness(self) -> str: ...
    @property
    def source_size(self) -> int: ...
    @property
    def interpreted_commands(self) -> int: ...
    @property
    def diagnostics(self) -> list[Diagnostic]: ...
    @property
    def raw(self) -> RawDocument | None: ...
    @property
    def final_state(self) -> PlotState: ...
    @property
    def pages(self) -> list[PlotPage]: ...
    def stats(self) -> dict[str, int]: ...
    def to_json(self) -> str: ...
    def to_svg(self, *, page: int = 0, margin_mm: float = 1.0) -> str: ...
    def write_json(self, path: str | PathLike[str]) -> None: ...
    def write_svg(self, path: str | PathLike[str], *, page: int = 0,
                  margin_mm: float = 1.0) -> None: ...

def parse(data: bytes, *, strict: bool = True, preserve_commands: bool = False,
          limits: Limits | None = None, geometry_limits: GeometryLimits | None = None,
          profile: DeviceProfile | None = None) -> PlotDocument: ...

class FontSpec:
    @property
    def symbol_set(self) -> int: ...
    @property
    def spacing(self) -> int: ...
    @property
    def pitch(self) -> float: ...
    @property
    def height_points(self) -> float: ...
    @property
    def posture(self) -> int: ...
    @property
    def weight(self) -> int: ...
    @property
    def typeface(self) -> int: ...

class TextState:
    @property
    def standard(self) -> FontSpec: ...
    @property
    def alternate(self) -> FontSpec: ...
    @property
    def use_alternate(self) -> bool: ...
    @property
    def size_mode(self) -> str: ...
    @property
    def width(self) -> float: ...
    @property
    def height(self) -> float: ...
    @property
    def direction(self) -> Point: ...
    @property
    def relative_direction(self) -> bool: ...
    @property
    def origin(self) -> int: ...
    @property
    def slant(self) -> float: ...
    @property
    def extra_space(self) -> Point: ...
    @property
    def path(self) -> int: ...
    @property
    def line(self) -> int: ...
    @property
    def transparent(self) -> bool: ...
    @property
    def carriage_return(self) -> Point: ...

class Glyph:
    @property
    def character(self) -> str: ...
    @property
    def source_offset(self) -> int: ...
    @property
    def origin(self) -> Point: ...
    @property
    def axis_x(self) -> Point: ...
    @property
    def axis_y(self) -> Point: ...
    @property
    def font(self) -> FontSpec: ...
    @property
    def envelope(self) -> list[Point]: ...

class Label:
    @property
    def data(self) -> bytes: ...
    @property
    def payload_span(self) -> SourceSpan: ...
    @property
    def terminator(self) -> int: ...
    @property
    def print_terminator(self) -> bool: ...
    @property
    def decoded(self) -> str: ...
    @property
    def glyphs(self) -> list[Glyph]: ...
    @property
    def unmapped_offsets(self) -> list[int]: ...
    @property
    def state(self) -> TextState: ...
    @property
    def start(self) -> Point: ...
    @property
    def end(self) -> Point: ...
    @property
    def approximate(self) -> bool: ...

class InputEvent:
    @property
    def kind(self) -> str: ...
    @property
    def span(self) -> SourceSpan: ...
    @property
    def command(self) -> str: ...
    @property
    def payload_span(self) -> SourceSpan | None: ...
